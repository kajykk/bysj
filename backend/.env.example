# ============================================
# Depression Warning System - 环境配置模板
# ============================================
# 复制此文件为 .env 并填写实际值
# 生产环境必须修改所有安全相关配置
# ============================================

# --- 应用基础配置 ---
APP_NAME="Depression Warning System"
APP_VERSION="3.1.0"
APP_ENV="development"

# --- 数据库配置 ---
# 开发环境: SQLite (默认)
DATABASE_URL="sqlite+aiosqlite:///depression_system.db"
# 生产环境: PostgreSQL (当 APP_ENV=production 时自动切换)
# DATABASE_URL="postgresql+asyncpg://depress_admin:CHANGE_ME_strong_password@postgres:5432/depression_system"

# --- Redis 配置 ---
REDIS_URL="redis://localhost:6379/0"

# --- JWT 安全配置 (必填) ---
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=""
# 签名算法: HS256 (对称, 默认) / RS256 (非对称, 生产多服务推荐)
# ISS-040 修复: RS256 模式豁免 JWT_SECRET_KEY 生产校验，改用下方密钥对
# 生成命令 (Linux/macOS/WSL):
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_ALGORITHM="HS256"
# RS256 模式密钥路径 (或直接用 JWT_PRIVATE_KEY_PEM/JWT_PUBLIC_KEY_PEM 内联 PEM 内容)
JWT_PRIVATE_KEY_PATH=""
JWT_PUBLIC_KEY_PATH=""
JWT_PRIVATE_KEY_PEM=""
JWT_PUBLIC_KEY_PEM=""
# JWT issuer/audience 声明 (防止 token 跨服务重放; 留空则不添加/不验证)
JWT_ISSUER=""
JWT_AUDIENCE=""
# ISS-039 修复: 60 分钟 (120 分钟过长, 被盗后窗口期大)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- 邮件服务配置 ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=""

# --- 密码重置链接 ---
# SEC-P1-002: 生产环境 (APP_ENV=production) 必须使用 https:// 前缀, 否则应用启动失败
# HTTP 链接会通过明文传输 password reset token, 存在中间人攻击风险
PASSWORD_RESET_BASE_URL="http://localhost:5173/reset-password"

# --- CORS 配置 ---
# 生产环境应限制为实际域名
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- 模型配置 ---
MODEL_DIR="models"

# --- 数据种子 ---
ENABLE_SEED=false

# --- E2E 种子账号密码 ---
# 开发/E2E 环境使用，生产环境必须修改
# 这些密码必须与 frontend/e2e/seed.spec.ts 中的硬编码值保持一致
E2E_ADMIN_PASSWORD="E2E@Admin123"
E2E_COUNSELOR_PASSWORD="E2E@Counselor123"
E2E_USER_PASSWORD="E2E@User123"

# --- Sentry 错误监控 (可选) ---
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- v1.37 Grafana Service Account 鉴权 ---
# Grafana Service Account Token (与根 .env 的 GRAFANA_SA_TOKEN 同步)
# 用于 Grafana JSON Datasource 调用后端 /grafana/* 端点时的鉴权
# 留空 (None) 表示禁用 SA 鉴权, 仅允许 Admin User JWT
# 生成示例: python -c "import secrets; print('glsa_' + secrets.token_urlsafe(32))"
GRAFANA_SERVICE_TOKEN=""
